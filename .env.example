# Optional. Copy to .env only when changing the local defaults.
# Never commit .env or the database.
HOST=127.0.0.1
PORT=3001
FRONTEND_PORT=5173
DATABASE_PATH=./data/lablink.sqlite

# Exact browser origins, comma separated without trailing slashes.
# Production requires the actual HTTPS origin instead of these local values.
APP_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# Operational targets measured from receipt, in hours.
# Have your laboratory approve these values for its workflows.
LABLINK_TAT_ROUTINE_HOURS=24
LABLINK_TAT_HIGH_HOURS=8
LABLINK_TAT_URGENT_HOURS=2

# Safe default: preview persists the exact message without contacting providers.
# Set live only after provisioning providers and verifying request-form contacts.
LABLINK_DELIVERY_MODE=preview

# Twilio SMS and WhatsApp (optional; keep credentials private).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=
# TWILIO_WHATSAPP_FROM=whatsapp:+15555550123
# Approved WhatsApp templates use {{1}} for sample reference and {{2}} for status.
# TWILIO_WHATSAPP_PATIENT_CONTENT_SID=
# TWILIO_WHATSAPP_CLINICIAN_CONTENT_SID=
# TWILIO_WHATSAPP_TRANSPORTER_CONTENT_SID=

# Resend transactional email (optional; use a verified sender domain).
# RESEND_API_KEY=
# RESEND_FROM=LabLink <notifications@your-laboratory.example>
